rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // IMPORTANT CONTEXT:
    // Because TEKPIK uses Next.js API Routes with the Firebase Admin SDK for 
    // almost all operations, the Admin SDK automatically bypasses these rules.
    // 
    // These rules ONLY apply to requests made directly from the user's browser
    // (Client SDK). Our client only accesses the `users/{uid}` collection directly 
    // via `auth-context.jsx` and `CMSLayout.jsx`.
    // -------------------------------------------------------------------------

    // 1. Users Collection
    // Users can only read and update their own profile document.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                    // Prevent users from granting themselves admin access
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'dashboardAccess']));
      allow delete: if false; // Only backend can delete users
    }

    // 2. Default Rule: Deny Everything Else
    // Any other direct browser requests are blocked. The Next.js backend API
    // routes will safely handle fetching products, writing analytics, sending 
    // mail, etc. using the Admin SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
